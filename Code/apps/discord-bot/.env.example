# Swarm Coordinator Discord Bot
# Copy this file to .env and fill in the values

# Discord Bot Token (from Discord Developer Portal)
DISCORD_BOT_TOKEN=your_bot_token_here

# Discord Application ID
DISCORD_CLIENT_ID=your_client_id_here

# Supabase connection (same as API server)
SUPABASE_URL=your_supabase_url
# Server-only: same Supabase key as API/Guardian in this environment.
# NODE_ENV=production selects PRODUCTION; keep local and production keys different.
# The selected key is required; legacy service-role fallback is not supported.
SUPABASE_SECRET_KEY_LOCALHOST=your_supabase_secret_api_key
# Local marker only; set the real production secret and NODE_ENV=production on its host.
# Never use added_in_Railway as a credential in a production runtime.
SUPABASE_SECRET_KEY_PRODUCTION=added_in_Railway

# Internal API authentication (REQUIRED — must match API server's BOT_API_SECRET)
BOT_API_SECRET=your_secure_random_secret_here
BOT_API_PORT=3002

# API server URL (bot delegates email sending to the API)
API_URL=http://localhost:3001

# Frontend URL (used in bot messages to link users back to the web app)
FRONTEND_URL=http://localhost:5173