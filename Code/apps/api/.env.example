# Coordination Manager API - environment template
#
# Guidance for humans and agents:
# - Copy to .env (git-ignored) and fill real values there. Never put real keys in this file.
# - Every value below is a placeholder. Keep placeholders obvious (your_..., <64-hex>, example.com).
# - When code reads a new process.env var, add it here in the matching section with a one-line comment.
# - Required vars are uncommented; optional vars are commented out with their default behavior.
# - Generate 64-hex keys with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# - Full classification (public/private, which platform holds what): environment-variables skill.

# Database (DATABASE_URL is only used for running migrations via psql, not by the app runtime)
DATABASE_URL=your_supabase_connection_string
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key
# Server-only sb_secret_ keys; separate localhost_api and production_api keys. Never VITE_*.
# Share each environment's key with its coordinator and Guardian services.
# NODE_ENV=production selects PRODUCTION; all other modes select LOCALHOST.
# The selected key is required for privileged access; legacy service-role fallback is not supported.
SUPABASE_SECRET_KEY_LOCALHOST=your_supabase_secret_api_key
# Local marker only; replace with the real production secret in Railway variables.
# Never use added_in_Railway as a credential in a production runtime.
SUPABASE_SECRET_KEY_PRODUCTION=added_in_Railway

# Google OAuth & Calendar
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3001/api/calendar-sources/google/callback

# Mailbox OAuth providers
# Optional override for Gmail mailbox connector (falls back to GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET)
MAILBOX_GOOGLE_CLIENT_ID=your_mailbox_google_client_id
MAILBOX_GOOGLE_CLIENT_SECRET=your_mailbox_google_client_secret
MAILBOX_GMAIL_REDIRECT_URI=http://localhost:3001/api/mailbox/oauth/gmail/callback
# Required for Outlook connector
MAILBOX_MICROSOFT_CLIENT_ID=your_mailbox_microsoft_client_id
MAILBOX_MICROSOFT_CLIENT_SECRET=your_mailbox_microsoft_client_secret
MAILBOX_OUTLOOK_REDIRECT_URI=http://localhost:3001/api/mailbox/oauth/outlook/callback
# 64 hex chars; falls back to SMTP_ENCRYPTION_KEY if unset (set both separately in production)
MAILBOX_ENCRYPTION_KEY=<64-hex>
MAILBOX_SERVER_AUTO_SYNC_ENABLED=true
MAILBOX_SERVER_AUTO_SYNC_INTERVAL_MS=600000
MAILBOX_SERVER_AUTO_SYNC_MAX_ACCOUNTS=100

# Background sync of linked calendars/events (defaults: enabled, 300000 ms, 100 users)
# USER_EVENTS_SERVER_AUTO_SYNC_ENABLED=true
# USER_EVENTS_SERVER_AUTO_SYNC_INTERVAL_MS=300000
# USER_EVENTS_SERVER_AUTO_SYNC_MAX_USERS=100

# Discord (Coordinator Bot) - the API only needs the client id (bot invite link).
# The bot token belongs in Code/apps/discord-bot/.env, not here.
DISCORD_CLIENT_ID=your_discord_client_id

# Discord Guardian Bot (separate bot application; the API uses these for guardian admin features)
GUARDIAN_BOT_TOKEN=your_guardian_bot_token
GUARDIAN_CLIENT_ID=your_guardian_client_id

# Bot-to-API internal communication (REQUIRED - no fallback default; same value in the bot's .env)
BOT_API_URL=http://localhost:3002
BOT_API_SECRET=your_secure_random_secret_here

# Authentication
JWT_SECRET=your_jwt_secret
TURNSTILE_SECRET_KEY=your_cloudflare_turnstile_secret_key
# Local-only escape hatch when JWT_SECRET is missing; ignored when NODE_ENV=production
# ALLOW_INSECURE_DEV_SIGNING=false

# Server
PORT=3001
# Set NODE_ENV=production in every deployed environment (Railway does NOT set it for you).
# Without it the API runs with dev behavior: no trust proxy (rate limits keyed on the proxy),
# non-secure cookies, setup/configure endpoints enabled, dev CORS, and morgan 'dev' logging.
# The API logs a startup WARNING when it detects Railway but NODE_ENV is not production.
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Public base URL of this API, used in links the API hands out (default: derived from the request)
# PUBLIC_API_URL=https://api.example.com
# Base URL used in verification-email links (default: http://localhost:$PORT)
# API_URL=https://api.example.com

# AI - Primary model (OpenAI)
AI_PROVIDER=openai
AI_API_KEY=your_openai_api_key
AI_MODEL=gpt-4o
# AI_BASE_URL=https://api.openai.com/v1   (auto-set when AI_PROVIDER=openai)
# Mailbox assessment prompt version tag (default: rubric-v2)
# AI_ASSESSMENT_PROMPT_VERSION=rubric-v2

# AI - ASI-1 Mini (optional, enables per-user model switching)
ASI_API_KEY=your_asi_api_key
# ASI_BASE_URL=https://api.asi1.ai/v1
# ASI_MODEL=asi1-mini

# Zoom OAuth (create app at https://marketplace.zoom.us -> Develop -> Build App -> OAuth)
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret
ZOOM_REDIRECT_URI=http://localhost:3001/api/zoom/callback
# Checked against the Authorization header of the deauthorization webhook (skipped when unset)
# ZOOM_VERIFICATION_TOKEN=your_zoom_verification_token

# Encryption of stored Zoom/Luma credentials (64 hex chars). Each falls back to ENCRYPTION_KEY,
# then to an insecure dev-only key - set at least ENCRYPTION_KEY in production.
# ENCRYPTION_KEY=<64-hex>
# ZOOM_ENCRYPTION_KEY=<64-hex>
# LUMA_ENCRYPTION_KEY=<64-hex>

# Email / SMTP - platform default sender
# Gmail: enable 2FA, then create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_sender_address@example.com
SMTP_PASS=your_gmail_app_password
# 32-byte key (64 hex chars) for encrypting per-user SMTP passwords in the database
SMTP_ENCRYPTION_KEY=<64-hex>
# Test-only: where email.test.ts sends its 2 real emails when SMTP is configured (default recipient@example.com)
# EMAIL_TEST_RECIPIENT=you@example.com
# Calendar change notifications: background dispatcher (every 30s) that emails
# organisers batched participation updates. Set to false to disable sending.
# CALENDAR_CHANGE_NOTIFICATIONS_ENABLED=true
# Test-only: set to 1 to run calendar-notifications.live.test.ts (sends 2 real emails)
# CALENDAR_NOTIFICATIONS_LIVE_EMAIL=1
# CALENDAR_NOTIFICATIONS_TEST_EMAIL=recipient@example.com
