# Demon X — Environment Variables

# Discord Bot Token (from Discord Developer Portal — separate bot application)
DISCORD_BOT_TOKEN=your_guardian_bot_token_here

# Discord Application ID (from the same bot application)
DISCORD_CLIENT_ID=your_guardian_client_id_here

# Supabase connection (same as API server — shared database)
SUPABASE_URL=your_supabase_url
# Server-only: same Supabase key as API/coordinator in this environment.
# NODE_ENV=production selects PRODUCTION; keep local and production keys different.
# The selected key is required; legacy service-role fallback is not supported.
SUPABASE_SECRET_KEY_LOCALHOST=your_supabase_secret_api_key
# Local marker only; set the real production secret and NODE_ENV=production on Railway.
# Never use added_in_Railway as a credential in a production runtime.
SUPABASE_SECRET_KEY_PRODUCTION=added_in_Railway

# Set to 'true' to skip Discord login (use when running local dev and production bot is active)
DISABLE_BOT=false
