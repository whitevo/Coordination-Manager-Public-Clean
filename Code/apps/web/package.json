{
  "name": "@coordination-manager/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js",
    "build": "tsc && vite build",
    "build:with-docs": "tsc && vite build && cd ../docs && pnpm run build && cd ../web && node scripts/copy-docs.js",
    "generate:og-image": "node scripts/generate-og-image.js",
    "verify:discovery": "node scripts/verify-discovery.js",
    "preview": "vite preview",
    "test": "vitest --run",
    "test:coverage": "vitest --coverage",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.6.2",
    "@supabase/supabase-js": "^2.118.0",
    "@tiptap/extension-details": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "axios": "^1.20.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
